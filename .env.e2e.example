# Plantilla sin valores. Copiar a frontend/.env.e2e (fuera de git). e2e/local/usuarios.mjs la llena con claves al azar.
# --- bullweb_test local (tenant sandbox de la copia) ---
E2E_LOCAL_ADMIN_EMAIL=
E2E_LOCAL_ADMIN_PASSWORD=
E2E_LOCAL_CAJERO_EMAIL=
E2E_LOCAL_CAJERO_PASSWORD=
E2E_LOCAL_MESERO_NAME=
E2E_LOCAL_MESERO_PIN=
# --- sandbox de produccion tu-mejor-sabor-216e63 ---
E2E_SANDBOX_ADMIN_EMAIL=
E2E_SANDBOX_ADMIN_PASSWORD=
E2E_SANDBOX_CAJERO_EMAIL=
E2E_SANDBOX_CAJERO_PASSWORD=
E2E_SANDBOX_MESERO_NAME=
E2E_SANDBOX_MESERO_PIN=
# --- F8: ids de OTRO tenant que el usuario del sandbox NO debe poder leer ---
E2E_LOCAL_AJENO_TENANT_ID=
E2E_LOCAL_AJENO_ORDER_ID=
E2E_LOCAL_AJENO_PRODUCT_ID=
E2E_LOCAL_AJENO_CUSTOMER_ID=
E2E_SANDBOX_AJENO_TENANT_ID=
E2E_SANDBOX_AJENO_ORDER_ID=
E2E_SANDBOX_AJENO_PRODUCT_ID=
E2E_SANDBOX_AJENO_CUSTOMER_ID=
# --- montaje local ---
E2E_PG_BIN=C:/Users/Francisco/bullweb_pgtest/pgsql/bin
E2E_PG_DATA=C:/Users/Francisco/bullweb_pgtest/data
